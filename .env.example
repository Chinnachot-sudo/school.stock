NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Use SUPABASE_SECRET_KEY (preferred) or legacy service role key; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate a separate high-entropy value for signing app sessions; do not reuse a Supabase key.
SESSION_SECRET=
ALLOW_EMERGENCY_FALLBACK=false
# Only for isolated local development; leave false/unset when data must go to Supabase.
ALLOW_LOCAL_JSON_DB=false
